{
  "name": "kubequest-app",
  "version": "1.0.0",
  "private": true,
  "description": "KubeQuest API: Express + tools module over Elasticsearch, instrumented with OpenTelemetry",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "index-all": "tsx ../scripts/index-all.ts",
    "typecheck:scripts": "tsc --noEmit -p ../scripts/tsconfig.json"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.5.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "pino": "10.4.0",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
