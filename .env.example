# Elasticsearch Serverless endpoint, for example https://my-project-a1b2c3.es.us-east-1.aws.elastic.cloud (no trailing slash)
ELASTIC_URL=
# Elasticsearch API key in its encoded form. Never commit it; in the cluster it comes from the app-credentials Secret
ELASTIC_API_KEY=
# Inference endpoint behind every semantic_text field. Fallback: .multilingual-e5-small-elasticsearch
ELASTIC_INFERENCE_ID=.jina-embeddings-v5-text-small
# Secret used to sign the location QR tokens (HMAC-SHA256 of the location id)
QR_SECRET=
# Pins "now" for the demo, for example 2026-11-10T09:05:00-07:00. Falls back to resources/seed-meta.json, then the real clock
SEED_NOW=
# Port the api listens on
PORT=8080
# Version reported by /healthz. The image build sets it to the commit SHA
APP_VERSION=dev
# Fallback model provider when Agent Builder is not available (Phase 02)
OPENAI_API_KEY=
# GitHub token for profile lookups at signup (Phase 02)
GITHUB_TOKEN=
# Optional: read the seed data from another folder instead of ./resources
# RESOURCES_DIR=
# OTLP endpoint of the in-cluster OpenTelemetry collector, set by the deployment (Collin's lane)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
